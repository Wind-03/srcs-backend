# --- Server ---
NODE_ENV=development
PORT=3000

# --- Database (Supabase Postgres) ---
# Pooled connection (PgBouncer) for the app:
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres?schema=public"
# Direct connection for migrations (Prisma migrate needs a non-pooled URL):
DIRECT_URL="postgresql://postgres:postgres@localhost:54322/postgres?schema=public"

# --- Auth ---
# Use a long random string in production (min 16 chars).
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=5
